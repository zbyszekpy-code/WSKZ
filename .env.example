# ai-router-poc configuration contract.
# Copy to `.env` for local overrides; Compose auto-loads `.env`.
# Never commit real secrets.

# Ollama (LLM) endpoint and model.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Ollama request resilience.
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.1

# SMTP delivery target (Mailpit in the PoC stack).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@ai-router.local

# Max length of the validated (stripped) message text.
MESSAGE_MAX_LENGTH=2000

# SMTP transport resilience.
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_RETRIES=3
SMTP_RETRY_BACKOFF_SECONDS=0.1

# Agent run bounds: wall-clock timeout, no-send retry budget, and reason length.
AGENT_TIMEOUT_SECONDS=180
AGENT_RETRY_BACKOFF_SECONDS=0.1
AGENT_REASON_MAX_LENGTH=300
AGENT_NO_SEND_MAX_ATTEMPTS=2

# Advanced: override the agent system prompt. Defaults to the pinned routing
# policy in `app/agent/policy.py`; only set this to experiment.
# AGENT_SYSTEM_PROMPT="You are the routing agent ..."
